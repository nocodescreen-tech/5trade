# .env.example
# Copier ce fichier en .env et remplir vos clés API

# DeepSeek API Key (obtenir depuis https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Port du serveur
PORT=3001

# Environnement
NODE_ENV=development

# Notifications push navigateur (Web Push VAPID)
# Générer avec : node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@5trade.com

# Coûts IA : plafond mensuel en USD (0 = illimité, défaut protecteur 5)
# + tarifs approximatifs par million de tokens + URL alternative OpenAI-compatible
# (ex. Ollama local gratuit : http://localhost:11434/v1/chat/completions)
BUDGET_MENSUEL_USD=5
COUT_USD_ENTREE_PM=0.27
COUT_USD_SORTIE_PM=1.10
# DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
# VISION_MAX_TOKENS=2048