# .env.example — 5trade
# Copier ce fichier en .env et remplir vos clés API

# ─── Analyse IA (NVIDIA NIM — gratuit) ───────────────────────────
# Source UNIQUE des analyses texte. Les modèles sont essayés en cascade.
NVIDIA_API_KEY=
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,mistralai/mistral-large-4-1t-a52b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_MS=45000
NVIDIA_MARGE_TOKENS=1500

# ─── Vision (captures de graphiques) ────────────────────────────
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-flash-preview
VISION_PROVIDER=gemini

# ─── Base de données ────────────────────────────────────────────
# PostgreSQL en production, repli JSON en local
# DATABASE_URL=postgresql://user:pass@host:5432/5trade

# ─── Port du serveur ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Budget IA ──────────────────────────────────────────────────
BUDGET_MENSUEL_USD=5

# ─── Notifications push navigateur (VAPID) ──────────────────────
# Générer avec : node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@5trade.com

# ─── SMTP (OTP email) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Stockage distant (facultatif) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=5trade
