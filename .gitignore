# Logs du serveur
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers temporaires
*.tmp
*.temp
uploads/

# Variables d'environnement
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Données sensibles
# ─── Données : on versionne ce qui n'est PAS personnel ───
# Les stratégies, concepts et documents, plus le lexique (les « termes ») et les
# réglages, doivent exister DANS l'image : sinon un déploiement depuis Git
# (Hostless, Render, Koyeb) démarre sur une application vide — les fichiers
# n'arrivent que si le build les voit. Les comptes, le journal de signaux et les
# caches restent locaux : ils sont en base en production.
data/*
!data/lexique.json
!data/alerts.json
!data/frais.json
!data/risque.json
!data/news-calendrier.json
knowledge-base/**
!knowledge-base/**/
!knowledge-base/*.json
!knowledge-base/documents/*

# Build
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Backup
*.bak
*.backup

# Outil de vérification (2 Mo, retéléchargé au besoin par verify.js)
api/babel.min.js

# Journaux du serveur lancé en tâche de fond
server.log
out.log
err.log

# Fichiers de travail et de diagnostic.
# ck.txt contient un cookie de session VIVANT (s5_session=…) : committé, il
# donnerait un accès à l'application à quiconque lit le dépôt. Il ne doit
# jamais partir sur GitHub.
ck*.txt
cookie*.txt
tm.json
audit-*.cjs
hermes-*.cjs
*-signal.json

srv.log
srv.err
.codex/

# Python (baseline ML) : environnement local, jamais versionne
ml/.venv/
ml/__pycache__/

# Dumps et exports locaux (données personnelles)
data/dump-*.sql

# Modeles de variables et blueprints : versionnes, sans secret
!.env.deploy.example
knowledge-base/documents/.hermes-tmp*
