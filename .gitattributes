# Les scripts lus par un shell Linux (conteneur) doivent être en LF strict :
# un shebang terminé par \r donne « ./docker-entrypoint.sh: not found ».
*.sh            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
docker-entrypoint.sh text eol=lf

# Les graines JSON ne doivent jamais etre renormalisees : git les reecrivait
# entierement a chaque commit (932 lignes), noyant les vraies modifications.
data/*.json -text
