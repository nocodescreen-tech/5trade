# 5trade — variables d'environnement pour un déploiement (modèle, sans secret)
#
# Copier les valeurs depuis le .env local. Une clé = une ligne dans l'interface
# de la plateforme (Render : Environment ; Koyeb : Environment variables ;
# Hostless : Environment ; Northflank : Environment). Un .env non versionné
# n'arrive JAMAIS dans l'image : .dockerignore l'exclut volontairement.

# ─── Obligatoire ────────────────────────────────────────────────
NODE_ENV=production
# Render/Hostless : fournie par la ressource PostgreSQL du projet.
# Jamais localhost/127.0.0.1 en production : le service tournerait sur une base
# injoignable (ou sur des fichiers éphémères).
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ─── IA payante (texte) ─────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Garde-fou de dépense. 0 = illimité (déconseillé).
BUDGET_MENSUEL_USD=5

# ─── Secours IA gratuit (NVIDIA NIM) ───────────────────────────
# Prend le relais automatiquement si DeepSeek est épuisé, en panne ou si le
# plafond mensuel est atteint. Gratuit, donc jamais compté dans le budget.
NVIDIA_API_KEY=
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,openai/gpt-oss-20b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,mistralai/mistral-large-4-1t-a52b
NVIDIA_TIMEOUT_MS=45000
NVIDIA_MARGE_TOKENS=1500

# ─── Vision (captures de graphiques) ───────────────────────────
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-flash-preview
GEMINI_VISION_SECOURS=
VISION_PROVIDER=gemini

# ─── Comptes : OTP par e-mail ──────────────────────────────────
# Sans SMTP, l'inscription ne peut pas envoyer de code. Beaucoup de PaaS
# bloquent le port SMTP sortant : dans ce cas, passer par une API HTTP
# (Brevo/Resend) plutôt que par SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_ON_LOGIN=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Stockage des fichiers envoyés ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=5trade
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ─── Marché / notifications push ───────────────────────────────
DERIV_API_TOKEN=
DERIV_APP_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# ─── Données (facultatif) ──────────────────────────────────────
# Valeurs par défaut de l'image : /app/state/{data,knowledge-base,uploads}.
# À surcharger seulement si la plateforme monte son volume ailleurs (Koyeb : /data).
# DATA_DIR=/app/state/data
# KNOWLEDGE_BASE_DIR=/app/state/knowledge-base
# UPLOADS_DIR=/app/state/uploads
# PORT est imposé par la plateforme (Render/Hostless l'injectent, Koyeb : 8000).
